<table class="overflow-scroll h-auto w-full" id="securities-list" phx-hook="SecuritiesList">
  <thead>
    <tr>
      <th class="text-center 2xl:text-xl p-2 2xl:px-4 2xl:py-2 border-b border-gray-800">Issuer</th>
      <th class="text-center 2xl:text-xl p-2 2xl:px-4 2xl:py-2 border-b border-gray-800">Price</th>
      <th class="text-center 2xl:text-xl p-2 2xl:px-4 2xl:py-2 border-b border-gray-800">Nominal price</th>
      <th class="text-center 2xl:text-xl p-2 2xl:px-4 2xl:py-2 border-b border-gray-800">Ask</th>
      <th class="text-center 2xl:text-xl p-2 2xl:px-4 2xl:py-2 border-b border-gray-800">Bid</th>
      <th class="text-center 2xl:text-xl p-2 2xl:px-4 2xl:py-2 border-b border-gray-800">Dividend ROI (%)</th>
      <th class="text-center 2xl:text-xl p-2 2xl:px-4 2xl:py-2 border-b border-gray-800">EPS ROI (%)</th>
      <th class="text-center 2xl:text-xl p-2 2xl:px-4 2xl:py-2 border-b border-gray-800">P/E</th>
      <th class="text-center 2xl:text-xl p-2 2xl:px-4 2xl:py-2 border-b border-gray-800">P/B</th>
      <th class="text-center 2xl:text-xl p-2 2xl:px-4 2xl:py-2 border-b border-gray-800" colspan="2">Market Value</th>
      <th class="text-center 2xl:text-xl p-2 2xl:px-4 2xl:py-2 border-b border-gray-800" colspan="2">Book Value</th>
      <th class="text-center 2xl:text-xl p-2 2xl:px-4 2xl:py-2 border-b border-gray-800">BVS</th>
      <th class="text-center 2xl:text-xl p-2 2xl:px-4 2xl:py-2 border-b border-gray-800">Profit margin</th>
    </tr>
  </thead>

  <tbody>
    <%= for security <- @securities do %>
      <tr class="transition-colors <%= if(security.newest, do: " bg-red-300", else: if(security.new, do: " bg-yellow-300", else: "")) %>">
        <td class="text-center p-2 2xl:px-4 2xl:py-2 border-t border-gray-400" rowspan="2">
          <a href="http://www.sase.ba/v1/Tržište/Emitenti/Profil-emitenta/symbol/<%= security.symbol %>" target="_blank" class="2xl:text-xl text-blue-400"><%= security.symbol %></a><br />
          <span class="2xl:text-lg"><%= security.name %></span><br />
          <span class="2xl:text-lg"><%= segment(security.segment) %></span>
        </td>
        <td class="text-center 2xl:text-xl p-2 2xl:px-4 2xl:py-2 border-t border-gray-400" rowspan="2"><%= Decimal.round(security.price, 2) %></td>
        <td class="text-center 2xl:text-xl p-2 2xl:px-4 2xl:py-2 border-t border-gray-400" rowspan="2"><%= Decimal.round(security.nominal_price, 2) %></td>
        <td class="text-center 2xl:text-xl p-2 2xl:px-4 2xl:py-2 border-t border-gray-400"><%= Decimal.round(security.ask_price, 2) %></td>
        <td class="text-center 2xl:text-xl p-2 2xl:px-4 2xl:py-2 border-t border-gray-400"><%= Decimal.round(security.bid_price, 2) %></td>
        <td class="text-center 2xl:text-xl p-2 2xl:px-4 2xl:py-2 border-t border-gray-400"><%= Decimal.round(Decimal.mult(security.dividend_roi, 100), 2) %>%</td>
        <td class="text-center 2xl:text-xl p-2 2xl:px-4 2xl:py-2 border-t border-gray-400"><%= Decimal.round(Decimal.mult(security.eps_roi, 100), 2) %>%</td>
        <td class="text-center 2xl:text-xl p-2 2xl:px-4 2xl:py-2 border-t border-gray-400" rowspan="2"><%= Decimal.round(security.pe, 2) %></td>
        <td class="text-center 2xl:text-xl p-2 2xl:px-4 2xl:py-2 border-t border-gray-400" rowspan="2"><%= Decimal.round(security.pb, 2) %></td>
        <td class="text-center 2xl:text-xl p-2 2xl:px-4 2xl:py-2 border-t border-gray-400" colspan="2" rowspan="2"><%= Decimal.round(security.market_value, 0) %></td>
        <td class="text-center 2xl:text-xl p-2 2xl:px-4 2xl:py-2 border-t border-gray-400" colspan="2"><%= Decimal.round(security.book_value, 0) %></td>
        <td class="text-center 2xl:text-xl p-2 2xl:px-4 2xl:py-2 border-t border-gray-400"><%= Decimal.round(security.bvs, 2) %></td>
        <td class="text-center 2xl:text-xl p-2 2xl:px-4 2xl:py-2 border-t border-gray-400"><%= Decimal.round(Decimal.mult(security.profit_margin, 100), 2) %>%</td>
      </tr>
      <tr class="transition-colors <%= if(security.newest, do: " bg-red-300", else: if(security.new, do: " bg-yellow-300", else: "")) %>">
        <td class="text-center 2xl:text-xl p-2 2xl:px-4 2xl:py-2"><%= security.ask_volume %></td>
        <td class="text-center 2xl:text-xl p-2 2xl:px-4 2xl:py-2"><%= security.bid_volume %></td>
        <td class="text-center 2xl:text-xl p-2 2xl:px-4 2xl:py-2"><%= Decimal.round(Decimal.mult(security.previous_dividend_roi, 100), 2) %>%</td>
        <td class="text-center 2xl:text-xl p-2 2xl:px-4 2xl:py-2"><%= Decimal.round(Decimal.mult(security.previous_eps_roi, 100), 2) %>%</td>
        <td class="text-center 2xl:text-xl p-2 2xl:px-4 2xl:py-2" colspan="2"><%= Decimal.round(security.previous_book_value, 0) %></td>
        <td class="text-center 2xl:text-xl p-2 2xl:px-4 2xl:py-2"><%= Decimal.round(security.previous_bvs, 2) %></td>
        <td class="text-center 2xl:text-xl p-2 2xl:px-4 2xl:py-2"><%= Decimal.round(Decimal.mult(security.previous_profit_margin, 100), 2) %>%</td>
      </tr>
    <% end %>
  </tbody>
</table>
