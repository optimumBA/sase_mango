<section class="px-2 2xl:px-6">

<.link navigate={~p"/investors"} class="absolute top-[100px] left-[55px] lg:left-[75px]">
  <TableIconsComponent.icon_back />
</.link>

  <HeaderComponent.header active_tab={@active_tab} />

  <div class="relative">
    <div class="mb-2 md:absolute md:right-16 md:-top-8 md:-translate-y-[100%] xl:right-16">
      <.live_component module={FilterFormComponent} id="filter_form" filter={@filter_options} />
    </div>

    <div class="md:mx-12 xl:mx-16 overflow-y-auto max-h-[70vh]">
      <p class="my-6 text-2xl font-normal mx-auto"><%= @investor.name %></p>

      <table class="investors-table font-montserrat">
        <thead>
          <tr>
            <th>#</th>

            <th :for={table_column <- @table_columns} class="">
              <div class="uppercase flex justify-center items-center gap-2">
                <TableComponents.sort_link column={table_column} sort_options={@sort_options} />
              </div>
            </th>
          </tr>
        </thead>

        <tbody id="issuers-list">
          <tr
            :for={{index, issuer} <- table_list_with_index(@table_list)}
            id={"issuer-#{issuer.symbol}"}
            class="hover:bg-[#b7deff]"
          >
            <td class="text-center p-4 2xl:px-4 2xl:py-2" colspan="1">
              <%= index %>
            </td>

            <td class="text-center p-4 2xl:px-4 2xl:py-2">
              <.link navigate={~p"/issuer/#{issuer.symbol}"} class="text-blue-400">
                <span><%= issuer.name %></span>
              </.link>
            </td>

            <td class="text-center p-4 2xl:px-4 2xl:py-2">
              <%= Decimal.round(issuer.investor_shares_number) %>
            </td>

            <td class="text-center p-4 2xl:px-4 2xl:py-2">
              <%= format_value(issuer.investor_shares_number, issuer.price) %>
            </td>

          </tr>
        </tbody>
        <tfoot></tfoot>
      </table>

      <div id="infinite-scroll-marker" phx-hook="TableInfiniteScroll" data-page-number={@page} />
    </div>
    <p class="text-xs py-4 fixed bottom-0 bg-white">
      <span class="font-bold">Note:</span>
      <span class="italic">
        Data is not accurate as it as based only on the top 10 investors for the companies 
      </span>
    </p>
  </div>
</section>
