
<section class="p-6">

<div class="mt-[6rem] mb-[2rem] text-[1.2em] py-4">
  <div class="flex items-center gap-4 px-2">
    <span class="text-[#8C8C8C] font-[400]">Date:</span>
    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M11.6667 2.66663H2.33333C1.59695 2.66663 1 3.26358 1 3.99996V13.3333C1 14.0697 1.59695 14.6666 2.33333 14.6666H11.6667C12.403 14.6666 13 14.0697 13 13.3333V3.99996C13 3.26358 12.403 2.66663 11.6667 2.66663Z" 
          stroke="#5B92D7" 
          stroke-linecap="round" 
          stroke-linejoin="round"
      />
      <path d="M9.66663 1.33337V4.00004" stroke="#5B92D7" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M4.33337 1.33337V4.00004" stroke="#5B92D7" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M1 6.66663H13" stroke="#5B92D7" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>

    <span class="font-[400]"><%= todays_date() %></span>
  </div>

  <div class="w-full mt-8 flex items-end justify-between border-b border-[#D9D9D9]">

    <div class="flex gap-6">
      <div class={"page-tab #{if @active_tab == :securities, do: "securities"}"} >
        <%= live_patch "List of securities", to: Routes.securities_index_path(@socket, :securities), 
          class: "page-link"
        %>
        <div class="tab-line"></div>
      </div>
      <div class={"page-tab #{if @active_tab == :bargains, do: "bargains"}"}>
        <%= live_patch "Bargain securities", to: Routes.securities_index_path(@socket, :bargains), 
          class: "page-link"
        %>
        <div class="tab-line"></div>
      </div>
      <div class="page-tab">
        <%= live_redirect "Calculator", to: Routes.calculator_path(@socket, :index), class: "page-link"
        %>
        <div class="tab-line"></div>
      </div>
    </div>

    <div></div>

  </div>

</div>

<table class="securities-table font-montserrat">
  <thead>
    <tr>
      <th class="">
        <div class="flex justify-center items-center gap-2">
          <SortingComponent.sort_link
            id={"sort-symbol"}
            col_text={"Symbol"}
            key={"symbol"}
            col_type={:text}
            sort_options={@sort_options} 
          />
        </div>
      </th>
      <th class="">
        <div class="flex justify-center items-center gap-2">
          <SortingComponent.sort_link
              id={"sort-issuer"}
              col_text={"Issuer"}
              key={"name"}
              col_type={:text}
              sort_options={@sort_options} 
            />
        </div>
      </th>
      <th class="" >
        <div class="flex justify-center items-center gap-2">
            <SortingComponent.sort_link
              id={"sort-price"}
              col_text={"Price"}
              key={"price"}
              col_type={:number}
              sort_options={@sort_options} 
            />
        </div>
      </th>
      <th class="" >
        <div class="flex justify-center items-center gap-2">
            <SortingComponent.sort_link
              id={"sort-nominal-price"}
              col_text={"Nominal price"}
              key={"nominal_price"}
              col_type={:number}
              sort_options={@sort_options} 
            />
        </div>
      </th>
      <th class="" colspan="2">
        <div class="flex justify-center items-center gap-2">
            <SortingComponent.sort_link
              id={"sort-ask"}
              col_text={"Ask"}
              key={"ask_price"}
              col_type={:number}
              sort_options={@sort_options} 
            />
        </div>
      </th>
      <th class="" colspan="2">
        <div class="flex justify-center items-center gap-2">
            <SortingComponent.sort_link
              id={"sort-bid"}
              col_text={"Bid"}
              key={"bid_price"}
              col_type={:number}
              sort_options={@sort_options} 
            />
        </div>
      </th>
      <th class="" >
        <div class="flex justify-center items-center gap-2">
            <SortingComponent.sort_link
              id={"sort-dividend-roi"}
              col_text={"Dividend ROI (%)"}
              key={"dividend_roi"}
              col_type={:number}
              sort_options={@sort_options} 
            />
        </div> 
      </th>
      <th class="">
        <div class="flex justify-center items-center gap-2">
            <SortingComponent.sort_link
              id={"sort-eps-roi"}
              col_text={"EPS ROI (%)"}
              key={"eps_roi"}
              col_type={:number}
              sort_options={@sort_options} 
            />
        </div>
      </th>
      <th class="">
        <div class="flex justify-center items-center gap-2">
            <SortingComponent.sort_link
              id={"sort-pe"}
              col_text={" P/E"}
              key={"pe"}
              col_type={:number}
              sort_options={@sort_options} 
            />
        </div>
      </th>
      <th class="">
        <div class="flex justify-center items-center gap-2">
            <SortingComponent.sort_link
              id={"sort-pb"}
              col_text={"P/B"}
              key={"pb"}
              col_type={:number}
              sort_options={@sort_options} 
            />
        </div>
      </th>
      <th class="" colspan="2">
        <div class="flex justify-center items-center gap-2">
            <SortingComponent.sort_link
              id={"sort-market-value"}
              col_text={"Market Value"}
              key={"market_value"}
              col_type={:number}
              sort_options={@sort_options} 
            />
        </div>
      </th>
      <th class="" colspan="2">
        <div class="flex justify-center items-center gap-2">
            <SortingComponent.sort_link
              id={"sort-book-value"}
              col_text={"Book Value"}
              key={"book_value"}
              col_type={:number}
              sort_options={@sort_options} 
            />
        </div>
      </th>
      <th class="">
        <div class="flex justify-center items-center gap-2">
            <SortingComponent.sort_link
              id={"sort-bvs"}
              col_text={"BVS"}
              key={"bvs"}
              col_type={:number}
              sort_options={@sort_options} 
            />
        </div>
      </th>
      <th class="">
        <div class="flex justify-center items-center gap-2">
            <SortingComponent.sort_link
              id={"sort-profit-margin"}
              col_text={"Profit margin"}
              key={"profit_margin"}
              col_type={:number}
              sort_options={@sort_options} 
            />
        </div>
      </th>
    </tr>
  </thead>
  <tbody id="securities">
    <%= for security <- @securities do %>
      <tr id={"security-#{security.symbol}"}>
        <td class=" p-2 2xl:px-4 2xl:py-2">
          <a href={"http://www.sase.ba/v1/Tržište/Emitenti/Profil-emitenta/symbol/#{security.symbol}"} target="_blank" 
            class=" text-blue-400"
          >
            <%= security.symbol %>
          </a>
        </td>
        <td class=" p-2 2xl:px-4 2xl:py-2">          
          <span class=""><%= security.name %></span><br />
          <span class=""><%= Securities.segment(security.segment) %></span>
        </td>
        <td class=" 2xl:text-xl p-2 2xl:px-4 2xl:py-2"><%= Decimal.round(security.price, 2) %></td>
        <td class=" 2xl:text-xl p-2 2xl:px-4 2xl:py-2"><%= Decimal.round(security.nominal_price, 2) %></td>
        <td class="p-2 2xl:px-4 2xl:py-2" colspan="2">
            <div class="flex flex-col gap-4">
                <span class=""><%= Decimal.round(security.ask_price, 2) %></span>
                <span class=""><%= security.ask_volume %></span>
            </div>            
        </td>
        <td class="p-2 2xl:px-4 2xl:py-2" colspan="2">
            <div class="flex flex-col gap-4">
                <span class=""><%= Decimal.round(security.bid_price, 2) %></span>
                <span class=""><%= security.bid_volume %></span>
            </div>
        </td>
        <td class="p-2 2xl:px-4 2xl:py-2 ">
            <div class="flex flex-col gap-4">
                <span class=""><%= Decimal.round(Decimal.mult(security.dividend_roi, 100), 2) %>%</span>
                <span class=""><%= Decimal.round(Decimal.mult(security.previous_dividend_roi, 100), 2) %>%</span>
            </div>
        </td>
        <td class="p-2 2xl:px-4 2xl:py-2 " >
            <div class="flex flex-col gap-4">
                <span class=""><%= Decimal.round(Decimal.mult(security.eps_roi, 100), 2) %>%</span>
                <span class=""><%= Decimal.round(Decimal.mult(security.previous_eps_roi, 100), 2) %>%</span>
            </div>
        </td>
        <td class=" 2xl:text-xl p-2 2xl:px-4 2xl:py-2 " ><%= Decimal.round(security.pe, 2) %></td>
        <td class=" 2xl:text-xl p-2 2xl:px-4 2xl:py-2 " ><%= Decimal.round(security.pb, 2) %></td>
        <td class=" 2xl:text-xl p-2 2xl:px-4 2xl:py-2 " colspan="2"><%= Decimal.round(security.market_value, 0) %></td>
        <td class="p-2 2xl:px-4 2xl:py-2 " colspan="2">
            <div class="flex flex-col gap-4">
                <span class=""><%= Decimal.round(security.book_value, 0) %></span>
                <span class=""><%= Decimal.round(security.previous_book_value, 0) %></span>
            </div>
        </td>
        <td class="p-2 2xl:px-4 2xl:py-2" >
            <div class="flex flex-col gap-4">
                <span class=""><%= Decimal.round(security.bvs, 2) %></span>
                <span class=""><%= Decimal.round(security.previous_bvs, 2) %></span>
            </div>
        </td>
        <td class="p-2 2xl:px-4 2xl:py-2 " >
            <div class="flex flex-col gap-4">
                <span class=""><%= Decimal.round(Decimal.mult(security.profit_margin, 100), 2) %>%</span>
                <span class=""><%= Decimal.round(Decimal.mult(security.previous_profit_margin, 100), 2) %>%</span>
            </div>
        </td>
      </tr>
    <% end %>
  </tbody>

</table>

  <%= if Enum.empty?(@securities) do %>
    <tr>
      <p class="w-max m-auto my-[4rem] text-[1.2em] alert alert-info"> 
      No results found!
      </p>
    </tr>
  <% end %>

</section>
