<section class="px-2 2xl:px-6">

  <HeaderComponent.header
    socket={@socket}
    active_tab={@active_tab}
   />

<div class="relative">

  <div class="mb-2 md:absolute md:right-16 md:-top-8 md:-translate-y-[100%] xl:right-16">
    <.live_component
      module={FilterFormComponent}
      id="filter_form"
      filter={@filter_options}
    />
  </div>

  <div class="table-wrapper overflow-y-auto max-h-[75vh]">
    <table class="securities-table font-montserrat">
      <thead>
        <tr>
          <th class="">
            <div class="flex justify-center items-center gap-2">
              <TableComponents.sort_link
                id={"sort-symbol"}
                col_text={"Symbol"}
                col_type={:text}
                key={"symbol"}
                sort_options={@sort_options}
              />
            </div>
          </th>
          <th class="">
            <div class="flex justify-center items-center gap-2">
              <TableComponents.sort_link
                id={"sort-issuer"}
                col_text={"Issuer"}
                col_type={:text}
                key={"name"}
                sort_options={@sort_options}
              />
            </div>
          </th>
          <th class="" >
            <div class="flex justify-center items-center gap-2">
              <TableComponents.sort_link
                id={"sort-price"}
                col_text={"Price"}
                col_type={:number}
                key={"price"}
                sort_options={@sort_options}
              />
            </div>
          </th>
          <th class="" >
            <div class="flex justify-center items-center gap-2">
              <TableComponents.sort_link
                id={"sort-nominal-price"}
                col_text={"Nominal price"}
                col_type={:number}
                key={"nominal_price"}
                sort_options={@sort_options}
              />
            </div>
          </th>
          <th class="" >
            <div class="flex justify-center items-center gap-2">
              <TableComponents.sort_link
                id={"sort-ask"}
                col_text={"Ask"}
                col_type={:number}
                key={"ask_price"}
                sort_options={@sort_options}
              />
            </div>
          </th>
          <th class="">
            <div class="flex justify-center items-center gap-2">
              <TableComponents.sort_link
                id={"sort-bid"}
                col_text={"Bid"}
                col_type={:number}
                key={"bid_price"}
                sort_options={@sort_options}
              />
            </div>
          </th>
          <th class="" >
            <div class="flex justify-center items-center gap-2">
              <TableComponents.sort_link
                id={"sort-dividend-roi"}
                col_text={"Dividend ROI (%)"}
                col_type={:number}
                key={"dividend_roi"}
                sort_options={@sort_options}
              />
            </div>
          </th>
          <th class="">
            <div class="flex justify-center items-center gap-2">
              <TableComponents.sort_link
                id={"sort-eps-roi"}
                col_text={"EPS ROI (%)"}
                col_type={:number}
                key={"eps_roi"}
                sort_options={@sort_options}
              />
            </div>
          </th>
          <th class="">
            <div class="flex justify-center items-center gap-2">
              <TableComponents.sort_link
                id={"sort-pe"}
                col_text={" P/E"}
                col_type={:number}
                key={"pe"}
                sort_options={@sort_options}
              />
            </div>
          </th>
          <th class="">
            <div class="flex justify-center items-center gap-2">
              <TableComponents.sort_link
                id={"sort-pb"}
                col_text={"P/B"}
                col_type={:number}
                key={"pb"}
                sort_options={@sort_options}
              />
            </div>
          </th>
          <th class="" >
            <div class="flex justify-center items-center gap-2">

              <TableComponents.sort_link
                id={"sort-market-value"}
                col_text={"Market Value"}
                col_type={:number}
                key={"market_value"}
                sort_options={@sort_options}
              />
            </div>
          </th>
          <th class="" >
            <div class="flex justify-center items-center gap-2">
              <TableComponents.sort_link
                id={"sort-book-value"}
                col_text={"Book Value"}
                col_type={:number}
                key={"book_value"}
                sort_options={@sort_options}
              />
            </div>
          </th>
          <th class="">
            <div class="flex justify-center items-center gap-2">
              <TableComponents.sort_link
                id={"sort-bvs"}
                col_text={"BVS"}
                col_type={:number}
                key={"bvs"}
                sort_options={@sort_options}
              />
            </div>
          </th>
          <th class="">
            <div class="flex justify-center items-center gap-2">
              <TableComponents.sort_link
                id={"sort-profit-margin"}
                col_text={"Profit margin"}
                col_type={:number}
                key={"profit_margin"}
                sort_options={@sort_options}
              />
            </div>
          </th>
        </tr>
      </thead>
      <tbody id="securities">
        <%= for security <- @securities do %>
          <TableComponents.table_row live_action={@active_tab} security={security} >

            <td class="text-center p-2 2xl:px-4 2xl:py-2">
              <a href={"http://www.sase.ba/v1/Tržište/Emitenti/Profil-emitenta/symbol/#{security.symbol}"} target="_blank"
                class=" text-blue-400"
              >
                <%= security.symbol %>
              </a>
            </td>
            <td class="text-center p-2 2xl:px-4 2xl:py-2">
              <span><%= security.name %></span><br />
              <span><%= Securities.segment(security.segment) %></span>
            </td>
            <TableComponents.one_value_number_cell value={Decimal.round(security.price, 2)} />
            <TableComponents.one_value_number_cell value={Decimal.round(security.nominal_price, 2)} />

            <TableComponents.double_value_number_cell first_value={Decimal.round(security.ask_price, 2)} second_value={security.ask_volume} />
            <TableComponents.double_value_number_cell first_value={Decimal.round(security.bid_price, 2)} second_value={security.bid_volume} />
            <TableComponents.double_value_number_cell first_value={Decimal.round(Decimal.mult(security.dividend_roi, 100), 2)}
              second_value={Decimal.round(Decimal.mult(security.previous_dividend_roi, 100), 2)} procent />

            <TableComponents.double_value_number_cell first_value={Decimal.round(Decimal.mult(security.eps_roi, 100), 2)}
              second_value={Decimal.round(Decimal.mult(security.previous_eps_roi, 100), 2)} procent />

            <TableComponents.one_value_number_cell value={Decimal.round(security.pe, 2)} />
            <TableComponents.one_value_number_cell value={Decimal.round(security.pb, 2)} />
            <TableComponents.one_value_number_cell value={Number.Delimit.number_to_delimited(security.market_value, delimiter: ",", separator: ".")} />

            <TableComponents.double_value_number_cell first_value={Number.Delimit.number_to_delimited(security.book_value, delimiter: ",", separator: ".")}
              second_value={Number.Delimit.number_to_delimited(security.previous_book_value, delimiter: ",", separator: ".")} />

            <TableComponents.double_value_number_cell first_value={Decimal.round(security.bvs, 2)}
              second_value={Decimal.round(security.previous_bvs, 2)} />

            <TableComponents.double_value_number_cell first_value={Decimal.round(Decimal.mult(security.profit_margin, 100), 2)}
              second_value={Decimal.round(Decimal.mult(security.previous_profit_margin, 100), 2)} procent />

          </TableComponents.table_row>
        <% end %>
      </tbody>

      <tfoot></tfoot>

    </table>
  </div>

  <%= if Enum.empty?(@securities) do %>
    <tr>
      <p class="w-max m-auto my-16 text-base alert alert-info"> No results found!</p>
    </tr>
  <% end %>
</div>

<div class="h-2 mt-4"></div>

</section>
