<section class="px-2 2xl:px-6">
  <HeaderComponent.header socket={@socket} active_tab={@active_tab} />

  <.form
    :let={f}
    for={@changeset}
    phx-submit="calculate"
    phx-change="validate"
    class="mx-12 xl:mx-16 my-8 border-b border-gray-350"
    phx-click="toggle_input"
  >
    <div class="w-full flex flex-col flex-wrap sm:flex-row items-center sm:items-end gap-8 pb-12">
      <div class="sm:w-max">
        <%= Phoenix.HTML.Form.label(f, :symbol, "Issuer or symbol",
          for: :symbol,
          class: "w-max mb-[0.5rem] text-sm xl:text-base font-light text-gray-450"
        ) %>
        <.live_component
          module={IssuerSelectComponent}
          id="issuers_select_comp"
          issuer_input_cover={@issuer_input_cover}
          options={@select_list}
          selected_issuer={@selected_issuer}
        />
      </div>

      <div class="sm:min-w-39 sm:max-w-39">
        <FormComponents.input_wrapper field={:price} form={f} label="Price">
          <div class="relative rounded-[0.7rem] shadow-none">
            <%= Phoenix.HTML.Form.text_input(f, :price,
              placeholder: "0.00",
              class:
                "border-1 border-gray-450 focus:border-gray-600 placeholder-gray-450 rounded-[0.6rem] h-11 p-2 text-sm xl:text-base font-light text-center placeholder:focus:text-transparent",
              phx_debounce: "500",
              autocomplete: "off"
            ) %>
            <div class="absolute inset-y-0 right-2 pr-3 xl:pr-1 flex items-center pointer-events-none">
              <span
                class={if(Keyword.has_key?(@changeset.errors, :price), do: "text-gray-450", else: "text-gray-600") <> " text-sm xl:text-base"}
                id="price-currency"
              >
                KM
              </span>
            </div>
          </div>
        </FormComponents.input_wrapper>
      </div>

      <div class="sm:min-w-39 sm:max-w-39">
        <FormComponents.input_wrapper field={:amount} form={f} label="Amount">
          <div class="relative rounded-[0.7rem] shadow-none">
            <%= Phoenix.HTML.Form.text_input(f, :amount,
              placeholder: "0",
              class:
                "border-1 border-gray-450 focus:border-gray-600 placeholder-gray-450 rounded-[0.6rem] h-11 p-2 text-sm xl:text-base font-light text-center placeholder:focus:text-transparent",
              phx_debounce: "500",
              autocomplete: "off"
            ) %>
          </div>
        </FormComponents.input_wrapper>
      </div>

      <div class="sm:min-w-39 sm:max-w-39">
        <FormComponents.input_wrapper field={:fee} form={f} label="Fee percentage">
          <div class="relative rounded-[0.7rem] shadow-none">
            <%= Phoenix.HTML.Form.text_input(f, :fee,
              placeholder: "0",
              phx_debounce: "500",
              class:
                "border-1 border-gray-450 focus:border-gray-600 placeholder-gray-450 rounded-[0.6rem] h-11 p-2 text-sm xl:text-base font-light text-center placeholder:focus:text-transparent",
              autocomplete: "off"
            ) %>
            <div class="absolute inset-y-0 right-2 pr-4 flex items-center pointer-events-none">
              <span
                class={if(Keyword.has_key?(@changeset.errors, :fee), do: "text-gray-450", else: "text-gray-600") <> " text-sm xl:text-base"}
                id="price-currency-2"
              >
                %
              </span>
            </div>
          </div>
        </FormComponents.input_wrapper>
      </div>

      <div class="w-39">
        <FormComponents.submit_button
          changeset={@changeset}
          class="bg-blue-dark-200 border border-blue-dark-200 hover:bg-violet-dark-350 hover:border-violet-dark disabled:bg-blue-dark-100 disabled:border-blue-dark-100 text-white py-2 rounded-[0.4rem] px-[2.5rem] text-base xl:font-semibold xl:text-lg"
          text="Calculate"
        />
      </div>
    </div>
    <p class="text-sm text-gray-450 mb-2">
      To calculate the price, please enter your requirements.
    </p>
  </.form>

  <%= if Enum.count(@results.securities) > 0 do %>
    <div class="mx-12 xl:mx-16">
      <p class="text-lg xl:text-xl text-gray-800">Stock prices</p>

      <table class="data-table overflow-scroll w-max h-auto my-6">
        <thead>
          <th class="text-center px-4" colspan="3">Symbol</th>
          <th class="text-center px-4" colspan="2">Name</th>
          <th class="text-center px-4">Amount</th>
          <th class="text-center px-4">Price in KM</th>
          <th class="text-center px-4" colspan="2">Total without fee percentage in KM</th>
          <th class="text-center px-4" colspan="2">Total with fee percentage in  KM</th>
        </thead>

        <tbody>
          <%= for result <- @results.securities do %>
            <tr class="h-6">
              <td class="text-center text-blue-400 px-4" colspan="3">
                <a
                  href={"http://www.sase.ba/v1/Tržište/Emitenti/Profil-emitenta/symbol/#{result.symbol}"}
                  target="_blank"
                >
                  <%= result.symbol %>
                </a>
              </td>
              <td class="text-center px-4" colspan="2"><%= result.name %></td>
              <td class="text-center px-4"><%= Decimal.round(result.amount, 0) %></td>
              <td class="text-center px-4"><%= Decimal.round(result.price, 2) %></td>
              <td class="text-center px-4" colspan="2">
                <%= Decimal.round(result.total_without_fee, 2) %>
              </td>
              <td class="text-center px-4" colspan="2">
                <%= Decimal.round(result.total_with_fee, 2) %>
              </td>
              <td class="text-center ">
                <TableIconsComponent.delete_row row_id={result.id} />
              </td>
            </tr>
          <% end %>

          <tr class="h-12">
            <td class="px-4 text-center font-bold" colspan="3">TOTAL</td>
            <td class="px-4" colspan="2"></td>
            <td class="px-4"></td>
            <td class="px-4"></td>
            <td class="px-4 text-center" colspan="2">
              <%= Decimal.round(@results.total_without_fee, 2) %>
            </td>
            <td class="text-center px-4" colspan="2">
              <%= Decimal.round(@results.total_with_fee, 2) %>
            </td>
            <td></td>
          </tr>
        </tbody>
      </table>
    </div>
  <% end %>
</section>
