{
  "repository": {},
  "description": " ",
  "license": "MIT",
  "scripts": {
    "deploy": "npm-run-all --parallel deploy-app.css deploy-static",
    "deploy-app.css": "NODE_ENV=production npx tailwindcss --minify --input=css/app.css --output=../priv/static/assets/app.css",
    "deploy-static": "cpx 'static/**/*' ../priv/static",
    "watch": "npm-run-all --parallel watch-app.css watch-static",
    "watch-app.css": "npx tailwindcss --input=css/app.css --output=../priv/static/assets/app.css --watch",
    "watch-static": "cpx 'static/**/*' ../priv/static --watch"
  },
  "dependencies": {
    "phoenix": "file:../deps/phoenix",
    "phoenix_html": "file:../deps/phoenix_html",
    "phoenix_live_view": "file:../deps/phoenix_live_view",
    "topbar": "^1.0.1"
  },
  "devDependencies": {
    "cpx": "^1.5.0",
    "npm-run-all": "^4.1.5",
    "tailwindcss": "^3.0.1"
  }
}
